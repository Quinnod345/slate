{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://slate.local/schemas/format.schema.json",
 "x-slate-files": ["formats/*.json"],
 "title": "Slate format template",
 "description": "formats/<name>.json: one kind of film Slate knows how to make (a social reel, an explainer, a brand film). It sets the runtime, the frame (aspects and sizes), the clock, the pace, the structure, the loudness target, the caption defaults, the channels each aspect is made for (whose safe zones come from formats/_platforms.json), the default budget and whether the film is for broadcast. Read through slate.formats.load(name), which validates the file against this schema and resolves zones and routes. formats/_platforms.json (the channel library) and formats/_shared.json (Slate's shared defaults) are validated against $defs.platforms_file and $defs.shared_file.",
 "type": "object",
 "required": ["name", "title", "summary", "runtime_s", "aspects", "default_aspect", "fps_num", "fps_den", "pace",
              "structure", "loudness", "captions", "budget", "broadcast", "generation", "engines"],
 "additionalProperties": false,
 "properties": {
  "$schema": {"type": "string"},
  "$comment": {"type": "string"},
  "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
           "description": "The format's name, the same as its file name (formats/<name>.json)."},
  "title": {"type": "string", "minLength": 1, "maxLength": 80},
  "summary": {"type": "string", "minLength": 1, "description": "One or two sentences: what this film is."},
  "use_when": {"type": "string", "description": "When to pick this format over the others."},
  "runtime_s": {"$ref": "#/$defs/runtime"},
  "aspects": {
   "type": "object", "minProperties": 1,
   "description": "The frames this format is made in, keyed by aspect ratio (\"16:9\", \"9:16\") or, where a platform sizes by device, by a device class (\"iphone-portrait\"). Each lists the channels it is made for.",
   "propertyNames": {"pattern": "^([0-9]+:[0-9]+|[a-z][a-z0-9-]*)$"},
   "additionalProperties": {"$ref": "#/$defs/aspect"}
  },
  "default_aspect": {"type": "string", "description": "The aspect a new film of this format gets unless it asks for another."},
  "fps_num": {"type": "integer", "minimum": 1},
  "fps_den": {"type": "integer", "minimum": 1},
  "type_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 3,
                 "description": "Type size relative to the kit's base, for aspects that don't set their own."},
  "pace": {"$ref": "#/$defs/pace"},
  "read_time": {"$ref": "#/$defs/read_time"},
  "on_screen_max_words": {"type": "integer", "minimum": 0,
                          "description": "Most on-screen words per shot (headline plus labels). 0 means the picture carries no words."},
  "structure": {"$ref": "#/$defs/structure"},
  "audio": {"enum": ["required", "optional", "none"],
            "description": "Whether the film has a soundtrack. \"none\" ships without an audio track (a muted autoplay loop)."},
  "loudness": {"$ref": "#/$defs/loudness"},
  "captions": {"$ref": "#/$defs/captions"},
  "budget": {"$ref": "#/$defs/budget"},
  "broadcast": {"type": "boolean",
                "description": "True when the film is made for film, TV or radio. Eleven Music's self-serve plans don't cover broadcast (Enterprise does), and broadcast loudness is EBU R 128 or ATSC A/85, not the web target. A film.json \"broadcast\" key overrides this."},
  "generation": {"enum": ["none", "rarely", "where-it-helps"],
                 "description": "The default generation setting a film of this format starts with; the requester can change it."},
  "engines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["remotion", "web", "ae"]},
              "description": "The engines that suit this format, best first."},
  "autonomous_default": {"type": "boolean",
                         "description": "True for the one format autonomous films use when none is named (a 15-45 second 9:16 reel)."},
  "capture": {"$ref": "#/$defs/capture"},
  "character": {"$ref": "#/$defs/character"},
  "loop": {"$ref": "#/$defs/loop"},
  "encode": {"$ref": "#/$defs/encode"},
  "content_rules": {"type": "array", "items": {"type": "string", "minLength": 1},
                    "description": "Rules the platform itself sets for what the film may show."},
  "zone_overrides": {
   "type": "object",
   "description": "A format's own safe zone for a channel, when it must differ from the channel library: {channel: {aspect: zone}}.",
   "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/zone"}}
  },
  "notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
  "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
 },
 "$defs": {
  "runtime": {
   "type": "object",
   "required": ["min", "max", "target"],
   "additionalProperties": false,
   "description": "Seconds. The script gate holds a film to its target ±10% (or the requester's own runtime).",
   "properties": {
    "min": {"type": "number", "exclusiveMinimum": 0},
    "max": {"type": "number", "exclusiveMinimum": 0},
    "target": {"type": "number", "exclusiveMinimum": 0},
    "options": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0},
                "description": "The lengths this format comes in, when it only comes in some (an ad: 6, 15 or 30 s)."}
   }
  },
  "aspect": {
   "type": "object",
   "required": ["width", "height", "channels"],
   "additionalProperties": false,
   "properties": {
    "width": {"type": "integer", "minimum": 16, "multipleOf": 2},
    "height": {"type": "integer", "minimum": 16, "multipleOf": 2},
    "channels": {"type": "array", "minItems": 1, "uniqueItems": true,
                 "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                 "description": "Channel keys from formats/_platforms.json."},
    "type_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 3},
    "label": {"type": "string"},
    "note": {"type": "string"}
   }
  },
  "pace": {
   "type": "object",
   "required": ["max_words_per_second"],
   "additionalProperties": false,
   "description": "Voice-over pace and placement. The keys are the ones slate.story reads.",
   "properties": {
    "max_words_per_second": {"type": "number", "exclusiveMinimum": 0, "maximum": 2.6,
                             "description": "VO words per second of shot: never above 2.6 (plan §7, stage 3)."},
    "speech_rate": {"type": "number", "exclusiveMinimum": 0,
                    "description": "Planning words per second of speech, until the real takes exist."},
    "lead": {"type": "number", "minimum": 0, "description": "A line starts this far into its shot (s)."},
    "tail": {"type": "number", "minimum": 0, "description": "The next shot starts this long after the line ends (s)."},
    "act_tail": {"type": "number", "minimum": 0, "description": "The tail at an act break (s)."},
    "min_tail": {"type": "number", "minimum": 0},
    "pace_headroom": {"type": "number", "minimum": 1},
    "note": {"type": "string"}
   }
  },
  "read_time": {
   "type": "object",
   "additionalProperties": false,
   "description": "On-screen read time: hold >= max(floor, base + per_word x words) once the text has settled.",
   "properties": {
    "floor": {"type": "number", "minimum": 0},
    "base": {"type": "number", "minimum": 0},
    "per_word": {"type": "number", "minimum": 0},
    "exit_factor": {"type": "number", "exclusiveMinimum": 0},
    "default_entrance": {"type": "number", "minimum": 0},
    "max_words": {"type": "number", "minimum": 0}
   }
  },
  "structure": {
   "type": "object",
   "required": ["acts", "beats"],
   "additionalProperties": false,
   "properties": {
    "acts": {
     "type": "object", "required": ["min", "max"], "additionalProperties": false,
     "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "minimum": 1}}
    },
    "beats": {
     "type": "array", "minItems": 1,
     "items": {
      "type": "object", "required": ["name", "job"], "additionalProperties": false,
      "properties": {
       "name": {"type": "string", "minLength": 1},
       "job": {"type": "string", "minLength": 1},
       "share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1,
                 "description": "Roughly how much of the runtime this beat takes."},
       "for": {"type": "array", "items": {"type": "number"},
               "description": "The runtimes (s) this beat applies to, when the format comes in several lengths."}
      }
     }
    },
    "rules": {"type": "array", "items": {"type": "string", "minLength": 1}}
   }
  },
  "loudness": {
   "type": "object",
   "required": ["lufs", "true_peak"],
   "additionalProperties": false,
   "properties": {
    "lufs": {"type": ["number", "null"], "maximum": 0,
             "description": "Integrated loudness target (LUFS). null only for a film with no audio track."},
    "true_peak": {"type": ["number", "null"], "maximum": 0, "description": "Ceiling in dBTP."},
    "tolerance_lu": {"type": "number", "minimum": 0},
    "standard": {"type": "string"},
    "note": {"type": "string"}
   }
  },
  "captions": {
   "type": "object",
   "required": ["needed", "burn_in", "max_lines", "max_chars", "max_cps", "min_s"],
   "additionalProperties": false,
   "description": "Caption defaults. slate.voice builds captions with max_chars, max_lines, max_cps and min_s; the QA captions and access gates check them (a format can tighten the limits, never loosen them).",
   "properties": {
    "needed": {"type": "boolean", "description": "False when the film has no speech to caption."},
    "burn_in": {"type": "boolean", "description": "True when captions are burned into the picture (by Remotion, in the brand's font)."},
    "renderer": {"enum": ["remotion", "web", "ae"]},
    "font": {"type": "string", "description": "\"brand\": the brand pack's caption (or body) family."},
    "sidecar": {"type": "array", "uniqueItems": true, "items": {"enum": ["srt", "vtt"]}},
    "max_lines": {"type": "integer", "minimum": 1, "maximum": 2},
    "max_chars": {"type": "integer", "minimum": 8, "maximum": 42},
    "max_cps": {"type": "number", "exclusiveMinimum": 0, "maximum": 17},
    "min_s": {"type": "number", "minimum": 0},
    "position": {"type": "string"},
    "note": {"type": "string"}
   }
  },
  "range": {
   "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0},
   "description": "[low, high]. The high end is the hard stop."
  },
  "budget": {
   "type": "object",
   "required": ["family", "elevenlabs", "higgsfield"],
   "additionalProperties": false,
   "description": "The default film budget (plan §8): ElevenLabs credits for the voice and the score, and Higgsfield Cloud API dollars. The top of each range is the hard stop; rework may go to rework_factor times it. Each part stays within its family's caps in formats/_shared.json.",
   "properties": {
    "family": {"enum": ["reel_or_ad", "explainer", "brand_film"]},
    "elevenlabs": {
     "type": "object", "required": ["vo", "score"], "additionalProperties": false,
     "properties": {"vo": {"$ref": "#/$defs/range"}, "score": {"$ref": "#/$defs/range"}}
    },
    "higgsfield": {"$ref": "#/$defs/range"},
    "rework_factor": {"type": "number", "minimum": 1},
    "note": {"type": "string"}
   }
  },
  "capture": {
   "type": "object",
   "required": ["source", "principle"],
   "additionalProperties": false,
   "properties": {
    "source": {"type": "string"},
    "principle": {"type": "string"},
    "rebuild_in_code_when": {"type": "array", "items": {"type": "string"}},
    "rules": {"type": "array", "items": {"type": "string"}}
   }
  },
  "character": {
   "type": "object",
   "required": ["source", "rules"],
   "additionalProperties": false,
   "properties": {
    "source": {"type": "string"},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
   }
  },
  "loop": {
   "type": "object",
   "required": ["seamless", "rules"],
   "additionalProperties": false,
   "properties": {
    "seamless": {"type": "boolean"},
    "attributes": {"type": "string"},
    "poster": {"type": "string"},
    "rules": {"type": "array", "items": {"type": "string"}}
   }
  },
  "encode": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "deliver": {"type": "array", "items": {"type": "string"}},
    "max_fps": {"type": "number", "exclusiveMinimum": 0},
    "max_bytes": {"type": "integer", "minimum": 1},
    "audio": {"type": "string"},
    "note": {"type": "string"}
   }
  },
  "source": {
   "type": "object",
   "required": ["title", "checked"],
   "additionalProperties": false,
   "properties": {
    "title": {"type": "string", "minLength": 1},
    "url": {"type": "string"},
    "checked": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The date this source was read."},
    "says": {"type": "string"}
   }
  },
  "zone": {
   "type": "object",
   "required": ["top", "bottom", "left", "right", "basis", "official", "source", "verified_on"],
   "additionalProperties": false,
   "description": "Where text and logos must not go, as fractions of the frame: margins from each edge, plus keep-out rectangles [x0, y0, x1, y1] measured from the top left.",
   "properties": {
    "top": {"type": "number", "minimum": 0, "maximum": 0.5},
    "bottom": {"type": "number", "minimum": 0, "maximum": 0.5},
    "left": {"type": "number", "minimum": 0, "maximum": 0.5},
    "right": {"type": "number", "minimum": 0, "maximum": 0.5},
    "keep_out": {"type": "array", "items": {"type": "array", "minItems": 4, "maxItems": 4,
                                            "items": {"type": "number", "minimum": 0, "maximum": 1}}},
    "basis": {"enum": ["official", "official-template", "standard", "geometry", "estimate"],
              "description": "official: the platform's own numbers; official-template: measured from the platform's own template files; standard: a published standard (EBU R 95); geometry: worked out from how the frame is shown; estimate: a careful guess, marked as one."},
    "official": {"type": "boolean"},
    "source": {"type": "string", "minLength": 1},
    "verified_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "note": {"type": "string"}
   }
  },
  "channel": {
   "type": "object",
   "required": ["label", "route", "aspects", "zones", "sources"],
   "additionalProperties": false,
   "properties": {
    "label": {"type": "string", "minLength": 1},
    "family": {"type": "string"},
    "route": {"enum": ["hero", "social"],
              "description": "hero: a derived film at master quality through the full pipeline; social: may take the fast route."},
    "broadcast": {"type": "boolean"},
    "aspects": {
     "type": "object", "minProperties": 1,
     "propertyNames": {"pattern": "^([0-9]+:[0-9]+|[a-z][a-z0-9-]*)$"},
     "additionalProperties": {
      "type": "object", "required": ["width", "height"], "additionalProperties": false,
      "properties": {
       "width": {"type": "integer", "minimum": 16},
       "height": {"type": "integer", "minimum": 16},
       "note": {"type": "string"}
      }
     }
    },
    "duration_s": {
     "type": "object", "additionalProperties": false,
     "properties": {"min": {"type": "number", "minimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0},
                    "note": {"type": "string"}}
    },
    "max_fps": {"type": "number", "exclusiveMinimum": 0},
    "specs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "zones": {"type": "object", "additionalProperties": {"$ref": "#/$defs/zone"}},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
   }
  },
  "platforms_file": {
   "type": "object",
   "required": ["verified_on", "channels", "aliases"],
   "additionalProperties": false,
   "properties": {
    "$comment": {"type": "string"},
    "verified_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "channels": {"type": "object", "minProperties": 1,
                 "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
                 "additionalProperties": {"$ref": "#/$defs/channel"}},
    "aliases": {"type": "object", "additionalProperties": {"type": "string"}}
   }
  },
  "family_budget": {
   "type": "object",
   "required": ["label", "elevenlabs", "higgsfield", "note"],
   "additionalProperties": false,
   "properties": {
    "label": {"type": "string"},
    "runtime_s": {"$ref": "#/$defs/range"},
    "elevenlabs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/range"}},
    "higgsfield": {"$ref": "#/$defs/range"},
    "note": {"type": "string"}
   }
  },
  "shared_file": {
   "type": "object",
   "required": ["pace", "captions", "loudness", "budgets", "routes", "aliases"],
   "additionalProperties": false,
   "properties": {
    "$comment": {"type": "string"},
    "pace": {
     "type": "object", "required": ["max_words_per_second"], "additionalProperties": false,
     "properties": {"max_words_per_second": {"type": "number"}, "source": {"type": "string"}}
    },
    "captions": {
     "type": "object", "required": ["max_lines", "max_cps", "min_s", "max_chars_by_aspect"], "additionalProperties": false,
     "properties": {
      "max_lines": {"type": "integer"},
      "max_cps": {"type": "number"},
      "min_s": {"type": "number"},
      "max_chars_by_aspect": {"type": "object", "additionalProperties": {"type": "integer"}},
      "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
     }
    },
    "loudness": {
     "type": "object", "required": ["web", "broadcast"], "additionalProperties": false,
     "properties": {
      "web": {"$ref": "#/$defs/loudness"},
      "broadcast": {"type": "object", "additionalProperties": {"$ref": "#/$defs/loudness"}},
      "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
     }
    },
    "budgets": {
     "type": "object",
     "required": ["reel_or_ad", "explainer", "brand_film", "onboarding", "rework_factor", "source"],
     "additionalProperties": false,
     "properties": {
      "reel_or_ad": {"$ref": "#/$defs/family_budget"},
      "explainer": {"$ref": "#/$defs/family_budget"},
      "brand_film": {"$ref": "#/$defs/family_budget"},
      "onboarding": {"$ref": "#/$defs/family_budget"},
      "rework_factor": {"type": "number", "minimum": 1},
      "source": {"type": "string"}
     }
    },
    "routes": {
     "type": "object", "required": ["hero", "social"],
     "additionalProperties": {
      "type": "object", "required": ["label", "quality", "pipeline"], "additionalProperties": true,
      "properties": {"label": {"type": "string"}, "quality": {"type": "string"}, "pipeline": {"type": "string"}}
     }
    },
    "broadcast": {"type": "object"},
    "aliases": {"type": "object", "additionalProperties": {"type": "string"}}
   }
  }
 }
}
