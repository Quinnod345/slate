{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "slate/voice_profile",
 "title": "VoiceProfile",
 "description": "A brand's voice (brand.json \"voice\"), optionally overridden per film (film.json \"voice\"). Designed or library voices by default. The only clone Slate accepts is the owner's own professional voice clone, verified by the owner with ElevenLabs; anyone else's voice is only ever a real recording, never a clone, and never a public figure's.",
 "type": "object",
 "properties": {
  "provider": {
   "enum": [
    "elevenlabs",
    "recording"
   ],
   "description": "elevenlabs: text to speech; recording: real recordings, no synthesis"
  },
  "source": {
   "enum": [
    "library",
    "designed",
    "clone",
    "recording"
   ]
  },
  "voice_id": {
   "type": [
    "string",
    "null"
   ],
   "minLength": 1
  },
  "voice_name": {
   "type": [
    "string",
    "null"
   ]
  },
  "model": {
   "type": [
    "string",
    "null"
   ],
   "description": "TTS model id; default: registry role tts (eleven_v4)"
  },
  "settings": {
   "type": "object",
   "properties": {
    "stability": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "similarity_boost": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "style": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "speed": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 2
    },
    "use_speaker_boost": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "seed": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 0,
   "maximum": 4294967295
  },
  "output_format": {
   "type": "string",
   "pattern": "^(pcm|wav|mp3|opus|ulaw|alaw)_[0-9a-z_]+$"
  },
  "language": {
   "type": "string",
   "minLength": 2
  },
  "lexicon": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   },
   "description": "brand words Whisper must hear in full"
  },
  "heard_as": {
   "type": "object",
   "description": "How Whisper spells a brand name it mishears, {name: spelling or [spellings]}, so the sound gates' hearing check reads those spellings as the name (slate.sound.hear.heard_as); never a licence to mispronounce it",
   "additionalProperties": {
    "oneOf": [
     {
      "type": "string",
      "minLength": 1
     },
     {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    ]
   }
  },
  "tag_policy": {
   "type": "object",
      "properties": {
        "avoid_low_effort": {"type": "boolean"},
        "banned_extra": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "allowed": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "string"
     }
    },
    "max_tags_per_line": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "clone_of": {
   "type": [
    "string",
    "null"
   ],
   "description": "\"owner\" for the owner's own voice; any other value names someone else (refused as a clone)"
  },
  "clone_kind": {
   "enum": [
    "professional",
    "instant",
    null
   ]
  },
  "verified_by_owner": {
   "type": "boolean",
   "description": "the owner completed ElevenLabs' own voice verification for this professional clone"
  },
  "public_figure": {
   "type": "boolean"
  },
  "speaker": {
   "type": [
    "string",
    "null"
   ],
   "description": "whose real recordings these are (source: recording)"
  },
  "library_approval": {
   "description": "The owner's recorded yes for one shared ElevenLabs Voice Library voice the vendor labels \"professional\": it is then used as a library voice. Never an instant clone, a famous voice or a clone of a named person.",
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "voice_id": {"type": "string", "description": "the one voice this approval covers"},
    "vendor_category": {"enum": ["professional"]},
    "voice_name": {"type": ["string", "null"]},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "description": "YYYY-MM-DD"},
    "ruling": {"type": "string", "minLength": 1, "description": "where the owner's words are recorded (a path or a quote)"},
    "ruling_sha256": {"type": ["string", "null"]},
    "autonomous": {"type": "boolean", "description": "autonomous films may use it too (default false)"},
    "note": {"type": ["string", "null"]}
   },
   "required": ["voice_id", "vendor_category", "approved_by", "approved_at", "ruling"],
   "additionalProperties": false
  },
  "pace": {
   "type": "object",
   "properties": {
    "tempo": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 2
    },
    "pause_keep": {
     "type": "number",
     "minimum": 0.1,
     "maximum": 1
    },
    "min_pause": {
     "type": "number",
     "minimum": 0,
     "maximum": 5
    },
    "threshold_db": {
     "type": "number",
     "maximum": 0
    }
   },
   "additionalProperties": false
  },
  "clean": {
   "type": "object",
   "properties": {
    "chain": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "fit": {
   "type": "object",
   "properties": {
    "lead_s": {
     "type": "number",
     "minimum": 0
    },
    "tail_s": {
     "type": "number",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "targets": {
   "type": "object",
   "properties": {
    "wpm": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "sentence_pause_s": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "sentence_pause_min_s": {
     "type": "number"
    },
    "f0_range_st": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "f0_hz": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "gap_floor_dbfs": {
     "type": "number"
    }
   },
   "additionalProperties": false
  },
  "candidates": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "voice_id"
    ],
    "properties": {
     "voice_id": {
      "type": "string",
      "minLength": 1
     },
     "name": {
      "type": "string"
     },
     "source": {
      "enum": [
       "library",
       "designed",
       "clone"
      ]
     },
     "clone_of": {
      "type": [
       "string",
       "null"
      ]
     },
     "clone_kind": {
      "enum": [
       "professional",
       "instant",
       null
      ]
     },
     "verified_by_owner": {
      "type": "boolean"
     },
     "public_figure": {
      "type": "boolean"
     }
    }
   }
  },
  "cast_text": {
   "type": [
    "string",
    "null"
   ],
   "description": "the line a casting shootout reads when the film has no storyboard yet"
  },
  "brand": {
   "type": [
    "string",
    "null"
   ]
  },
  "polish": {
   "type": "object",
   "description": "The studio polish tuned for this voice (slate voice polish). points: named complete chains (e.g. A, the subtler side of a marked change, and B, the warmer side); strengths: each point's place on the 0-1 scale (0 leaves a take untouched; a number between points blends them). Omitted parts come from Slate's neutral chain.",
   "properties": {
    "source": {
     "type": [
      "string",
      "null"
     ],
     "description": "where the tuning came from (the measurements it was tuned on)"
    },
    "required": {
     "type": "boolean",
     "description": "every take of this voice must be polished before the voice gates pass"
    },
    "default_strength": {
     "type": [
      "string",
      "null"
     ]
    },
    "strengths": {
     "type": "object",
     "additionalProperties": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
     }
    },
    "points": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/polish_chain"
     }
    },
    "verify": {
     "type": "object",
     "additionalProperties": {
      "type": "number"
     }
    }
   },
   "additionalProperties": false
  }
 },
 "required": [
  "provider",
  "source"
 ],
 "allOf": [
  {
   "if": {
    "properties": {
     "source": {
      "const": "clone"
     }
    }
   },
   "then": {
    "required": [
     "clone_of"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "source": {
      "const": "recording"
     }
    }
   },
   "then": {
    "properties": {
     "provider": {
      "const": "recording"
     }
    }
   }
  }
 ],
 "$defs": {
  "polish_chain": {
   "type": "object",
   "description": "One complete (or partial: the neutral chain fills the rest) studio vocal chain. Every stage keeps the take's length sample for sample.",
   "properties": {
    "highpass_hz": {
     "type": "number",
     "minimum": 0
    },
    "low_mid": {
     "type": "object",
     "properties": {
      "hz": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "gain_db": {
       "type": "number",
       "minimum": -24,
       "maximum": 24
      },
      "q": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "additionalProperties": false
    },
    "compressor": {
     "type": "object",
     "properties": {
      "threshold_db": {
       "type": "number",
       "maximum": 0
      },
      "ratio": {
       "type": "number",
       "minimum": 1
      },
      "attack_ms": {
       "type": "number",
       "minimum": 0
      },
      "release_ms": {
       "type": "number",
       "minimum": 0
      }
     },
     "additionalProperties": false
    },
    "edge": {
     "type": "object",
     "required": [
      "band_hz",
      "threshold_db",
      "ratio",
      "max_cut_db",
      "attack_ms",
      "release_ms"
     ],
     "properties": {
      "band_hz": {
       "type": "array",
       "items": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "minItems": 2,
       "maxItems": 2
      },
      "threshold_db": {
       "type": "number",
       "maximum": 0
      },
      "relative_db": {
       "type": [
        "number",
        "null"
       ]
      },
      "ratio": {
       "type": "number",
       "minimum": 1
      },
      "max_cut_db": {
       "type": "number",
       "minimum": 0,
       "maximum": 24
      },
      "attack_ms": {
       "type": "number",
       "minimum": 0
      },
      "release_ms": {
       "type": "number",
       "minimum": 0
      },
      "lookahead_ms": {
       "type": "number",
       "minimum": 0,
       "maximum": 20
      }
     },
     "additionalProperties": false
    },
    "deess": {
     "type": "object",
     "required": [
      "band_hz",
      "threshold_db",
      "ratio",
      "max_cut_db",
      "attack_ms",
      "release_ms"
     ],
     "properties": {
      "band_hz": {
       "type": "array",
       "items": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "minItems": 2,
       "maxItems": 2
      },
      "threshold_db": {
       "type": "number",
       "maximum": 0
      },
      "relative_db": {
       "type": [
        "number",
        "null"
       ]
      },
      "ratio": {
       "type": "number",
       "minimum": 1
      },
      "max_cut_db": {
       "type": "number",
       "minimum": 0,
       "maximum": 24
      },
      "attack_ms": {
       "type": "number",
       "minimum": 0
      },
      "release_ms": {
       "type": "number",
       "minimum": 0
      },
      "lookahead_ms": {
       "type": "number",
       "minimum": 0,
       "maximum": 20
      }
     },
     "additionalProperties": false
    },
    "presence": {
     "type": "object",
     "properties": {
      "hz": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "gain_db": {
       "type": "number",
       "minimum": -24,
       "maximum": 24
      },
      "q": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "additionalProperties": false
    },
    "low_shelf": {
     "type": "object",
     "properties": {
      "hz": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "gain_db": {
       "type": "number",
       "minimum": -24,
       "maximum": 24
      },
      "q": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "additionalProperties": false
    },
    "high_shelf": {
     "type": "object",
     "properties": {
      "hz": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "gain_db": {
       "type": "number",
       "minimum": -24,
       "maximum": 24
      },
      "q": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "additionalProperties": false
    },
    "room": {
     "type": "object",
     "properties": {
      "wet_db": {
       "type": "number",
       "maximum": 0
      },
      "rt60_s": {
       "type": "number",
       "minimum": 0.05,
       "maximum": 2
      }
     },
     "additionalProperties": false
    },
    "work_lufs": {
     "type": "number",
     "maximum": 0
    },
    "peak_ceiling_dbtp": {
     "type": "number",
     "maximum": 0
    }
   },
   "additionalProperties": false
  }
 }
}
