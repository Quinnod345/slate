{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "slate/voice_take",
 "title": "Voice take",
 "description": "One read of one line: voice/takes/<shot>/<take>.json beside <take>.wav. Records everything needed to make the same read again (model, voice, settings, seed, the exact text and context sent) and to find what was paid for (request ids, billed characters, the ledger row).",
 "type": "object",
 "required": ["shot", "take", "text", "sent", "model", "voice_id", "voice_settings", "seed", "format", "request_id",
              "file", "sha256", "seconds", "replay", "created_at"],
 "properties": {
  "generated": {"type": "string"},
  "shot": {"type": "string", "minLength": 1},
  "take": {"type": "string", "pattern": "^t[0-9]{2,}$"},
  "film": {"type": "string"},
  "brand": {"type": ["string", "null"]},
  "mode": {"enum": ["supervised", "express", "draft", "autonomous"]},
  "text": {"type": "string", "minLength": 1, "description": "the script line, plain"},
  "sent": {"type": "string", "minLength": 1, "description": "what was sent: the line with its audio tags"},
  "tags": {"type": "array", "items": {"type": "string"}},
  "previous_text": {"type": ["string", "null"]},
  "next_text": {"type": ["string", "null"]},
  "model": {"type": "string", "minLength": 1},
  "voice_id": {"type": "string", "minLength": 1},
  "voice_name": {"type": ["string", "null"]},
  "voice_source": {"enum": ["library", "designed", "clone", "recording", null]},
  "voice_settings": {"type": "object"},
  "seed": {"type": ["integer", "null"]},
  "format": {"type": "string"},
  "format_wanted": {"type": ["string", "null"]},
  "format_reason": {"type": ["string", "null"]},
  "format_fallbacks": {"type": "array"},
  "tier": {"type": ["string", "null"]},
  "lossless": {"type": "boolean"},
  "sample_rate": {"type": "integer"},
  "request_id": {"type": "string", "minLength": 1},
  "client_request_id": {"type": ["string", "null"]},
  "character_cost": {"type": ["number", "null"]},
  "ledger_row": {"type": ["string", "null"]},
  "replay": {"type": "boolean"},
  "replay_words": {"type": "array", "items": {"type": "object", "required": ["word", "start", "end"]}},
  "file": {"type": "string"},
  "source_file": {"type": ["string", "null"]},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "seconds": {"type": "number", "minimum": 0},
  "fit": {"type": "object"},
  "created_at": {"type": "string"},
  "stages": {"type": "object", "description": "clean, pace and align records for this take"}
 }
}
