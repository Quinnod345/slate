{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://slate.local/schemas/film.schema.json",
 "x-slate-files": ["film.json"],
 "title": "Slate film",
 "description": "film.json: what a film is (id, format, clock, size, brand, voice, targets, budget, mode) and what it has pinned. Written by slate.state (slate new, slate film set|pin|repin, slate variant); every module reads it. Other modules may add their own keys, so unknown keys are allowed.",
 "type": "object",
 "required": ["schema", "id", "title", "format", "language", "fps_num", "fps_den", "width", "height", "aspect", "brand",
              "voice", "targets", "budget", "mode", "generation", "parent", "derivation", "pins", "pin_log", "models",
              "versions", "created_at", "slate_version"],
 "additionalProperties": true,
 "properties": {
  "schema": {"const": 1},
  "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$",
         "description": "The film's id and its folder name: lowercase letters, digits, dots, dashes and underscores."},
  "title": {"type": "string", "minLength": 1, "maxLength": 200},
  "format": {"type": "string", "minLength": 1,
             "description": "The format template the film was made from (formats/<name>.json), e.g. a social reel or an explainer."},
  "format_source": {"type": ["string", "null"], "description": "Where the format came from (slate.formats or a file path)."},
  "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
               "description": "The language of the film's words (BCP 47). v1 speaks English; language stays data, never a literal in code."},
  "fps_num": {"type": "integer", "minimum": 1},
  "fps_den": {"type": "integer", "minimum": 1},
  "width": {"type": "integer", "minimum": 16, "multipleOf": 2},
  "height": {"type": "integer", "minimum": 16, "multipleOf": 2},
  "aspect": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
  "brand": {"type": "string", "minLength": 1, "description": "The brand pack's name (brands/<name>/brand.json)."},
  "brand_dir": {"type": ["string", "null"]},
  "voice": {
   "type": ["object", "null"],
   "description": "The voice this film speaks with: from the brand pack, a library voice (draft), or set later by the voice stage.",
   "properties": {
    "source": {"enum": ["brand", "library", "designed", "clone", "recording", "unset"]},
    "provider": {"type": ["string", "null"]},
    "voice_id": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "settings": {"type": ["object", "null"]},
    "note": {"type": ["string", "null"]}
   }
  },
  "targets": {
   "type": "object",
   "required": ["runtime_s", "lufs", "true_peak"],
   "properties": {
    "runtime_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "runtime_range_s": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
    "lufs": {"type": ["number", "null"], "maximum": 0},
    "true_peak": {"type": ["number", "null"], "maximum": 0}
   }
  },
  "budget": {
   "type": "object",
   "required": ["elevenlabs", "higgsfield", "rework_factor"],
   "description": "Hard stops per provider for this film (ElevenLabs credits, Higgsfield US dollars). slate.ledger enforces them.",
   "properties": {
    "elevenlabs": {"type": ["number", "null"], "minimum": 0},
    "higgsfield": {"type": ["number", "null"], "minimum": 0},
    "rework_factor": {"type": "number", "minimum": 1}
   }
  },
  "mode": {"enum": ["supervised", "express", "draft", "autonomous"]},
  "generation": {"enum": ["none", "rarely", "where-it-helps"],
                 "description": "How much generated footage the requester wants. Rarely by default; code builds anything designed."},
  "parent": {
   "type": ["object", "null"],
   "required": ["id", "dir"],
   "properties": {"id": {"type": "string"}, "dir": {"type": "string"}},
   "description": "The film this one is derived from (a cut-down, a new aspect, a new language or a full-length channel variant), or null."
  },
  "derivation": {
   "type": ["object", "null"],
   "required": ["kind", "kinds"],
   "properties": {
    "kind": {"enum": ["cutdown", "aspect", "language", "channel"]},
    "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cutdown", "aspect", "language", "channel"]}},
    "aspect": {"type": ["string", "null"]},
    "cut_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "language": {"type": ["string", "null"]},
    "format": {"type": ["string", "null"]}
   }
  },
  "pins": {
   "type": "object",
   "description": "Values fixed at first use (TTS model, voice id, settings, seeds, request ids, music and plate models, Remotion and Chrome versions). A registry refresh never changes them; re-pinning is explicit (slate film repin).",
   "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,119}$"}
  },
  "pin_log": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["key", "event", "at"],
    "properties": {
     "key": {"type": "string"},
     "event": {"enum": ["pin", "repin", "inherited"]},
     "at": {"type": "string"},
     "value": {},
     "previous": {},
     "approved_by": {"type": ["string", "null"]},
     "reason": {"type": ["string", "null"]},
     "evidence": {"type": ["string", "null"]},
     "source": {"type": ["string", "null"]}
    }
   }
  },
  "models": {"type": "object", "additionalProperties": {"type": "string"},
             "description": "Per-film model overrides by role (see registry.json roles). A pin still wins."},
  "versions": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["n", "started_at"],
    "properties": {
     "n": {"type": "integer", "minimum": 1},
     "started_at": {"type": "string"},
     "note": {"type": ["string", "null"]},
     "delivered_at": {"type": ["string", "null"]}
    }
   }
  },
  "created_at": {"type": "string"},
  "slate_version": {"type": "string"}
 }
}
