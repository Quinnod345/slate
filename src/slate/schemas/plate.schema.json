{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://slate.local/schemas/plate.schema.json",
 "title": "Plate record",
 "description": "A conformed plate (plates/<shot>/plate/plate.json), written by `slate plates conform` from an approved take: a JPEG sequence at the film's frame rate, with provenance. $defs holds the plates plan (plates/plan.json), a bridge matte (plates/<shot>/matte/matte.json) and an edge track (plates/<shot>/plate/track.json).",
 "type": "object",
 "required": [
  "schema",
  "id",
  "shot",
  "take",
  "source",
  "frames",
  "provenance"
 ],
 "properties": {
  "generated": {
   "type": "string"
  },
  "schema": {
   "const": 1
  },
  "id": {
   "$ref": "#/$defs/shot_id"
  },
  "shot": {
   "$ref": "#/$defs/shot_id"
  },
  "covers": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/shot_id"
   }
  },
  "take": {
   "type": "string",
   "pattern": "^t[0-9]+$"
  },
  "source": {
   "$ref": "#/$defs/source"
  },
  "frames": {
   "$ref": "#/$defs/sequence"
  },
  "duration": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "ambience": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "file",
    "rate",
    "bits"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "rate": {
     "type": "integer"
    },
    "bits": {
     "type": "integer"
    },
    "duration": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "prores": {
   "type": [
    "object",
    "null"
   ]
  },
  "provenance": {
   "type": "object",
   "required": [
    "lane",
    "provider",
    "request_id",
    "model",
    "estimated_usd",
    "actual_usd",
    "approved_by"
   ],
   "properties": {
    "lane": {
     "const": "cloud-api"
    },
    "provider": {
     "const": "higgsfield"
    },
    "request_id": {
     "type": "string"
    },
    "model": {
     "type": "string"
    },
    "role": {
     "type": "string"
    },
    "prompt": {
     "type": [
      "string",
      "null"
     ]
    },
    "estimated_usd": {
     "type": [
      "number",
      "null"
     ]
    },
    "discounted_usd": {
     "type": [
      "number",
      "null"
     ]
    },
    "actual_usd": {
     "type": [
      "number",
      "null"
     ]
    },
    "replay": {
     "type": "boolean"
    },
    "approved_by": {
     "type": "string",
     "minLength": 1
    },
    "approved_at": {
     "type": [
      "string",
      "null"
     ]
    },
    "take_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "submitted_at": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "covers_frames": {
   "type": [
    "integer",
    "null"
   ]
  },
  "warnings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "made_at": {
   "type": "string"
  },
  "tool": {
   "type": "object"
  }
 },
 "$defs": {
  "shot_id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "source": {
   "type": "object",
   "required": [
    "file",
    "sha256",
    "width",
    "height",
    "duration"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "sha256": {
     "$ref": "#/$defs/sha256"
    },
    "width": {
     "type": "integer",
     "minimum": 1
    },
    "height": {
     "type": "integer",
     "minimum": 1
    },
    "fps": {
     "type": [
      "string",
      "null"
     ]
    },
    "fps_float": {
     "type": [
      "number",
      "null"
     ]
    },
    "duration": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "frames": {
     "type": [
      "integer",
      "null"
     ]
    },
    "codec": {
     "type": [
      "string",
      "null"
     ]
    },
    "audio": {
     "type": "boolean"
    },
    "vfr": {
     "type": "boolean"
    }
   }
  },
  "sequence": {
   "type": "object",
   "required": [
    "dir",
    "pattern",
    "count",
    "fps_num",
    "fps_den",
    "width",
    "height"
   ],
   "properties": {
    "dir": {
     "type": "string"
    },
    "pattern": {
     "const": "f%05d.jpg"
    },
    "count": {
     "type": "integer",
     "minimum": 1
    },
    "first": {
     "const": 0
    },
    "fps_num": {
     "type": "integer",
     "minimum": 1
    },
    "fps_den": {
     "type": "integer",
     "minimum": 1
    },
    "width": {
     "type": "integer",
     "minimum": 1
    },
    "height": {
     "type": "integer",
     "minimum": 1
    },
    "method": {
     "enum": [
      "mci",
      "blend",
      "dup",
      "exact"
     ]
    },
    "fit": {
     "enum": [
      "cover",
      "contain",
      "native",
      "stretch"
     ]
    }
   }
  },
  "plan": {
   "description": "plates/plan.json: every shot with a generate block, the policy verdict, the model and the free estimate.",
   "type": "object",
   "required": [
    "schema",
    "setting",
    "mode",
    "shots",
    "totals"
   ],
   "properties": {
    "generated": {
     "type": "string"
    },
    "schema": {
     "const": 1
    },
    "film": {
     "type": [
      "string",
      "null"
     ]
    },
    "setting": {
     "enum": [
      "none",
      "rarely",
      "where-it-helps"
     ]
    },
    "mode": {
     "enum": [
      "supervised",
      "express",
      "draft",
      "autonomous"
     ]
    },
    "lane": {
     "const": "cloud-api"
    },
    "shots": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "shot",
       "allowed",
       "why"
      ],
      "properties": {
       "shot": {
        "$ref": "#/$defs/shot_id"
       },
       "allowed": {
        "type": "boolean"
       },
       "why": {
        "type": "string"
       },
       "reason": {
        "type": [
         "string",
         "null"
        ]
       },
       "role": {
        "type": [
         "string",
         "null"
        ]
       },
       "model": {
        "type": [
         "string",
         "null"
        ]
       },
       "takes": {
        "type": [
         "integer",
         "null"
        ]
       },
       "duration": {
        "type": [
         "number",
         "null"
        ]
       },
       "estimate_usd_per_take": {
        "type": [
         "number",
         "null"
        ]
       },
       "estimate_usd_total": {
        "type": [
         "number",
         "null"
        ]
       },
       "needs_approval": {
        "type": "boolean"
       },
       "uploads": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "problems": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "status": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    },
    "totals": {
     "type": "object",
     "required": [
      "shots",
      "allowed",
      "takes",
      "estimate_usd"
     ],
     "properties": {
      "shots": {
       "type": "integer"
      },
      "allowed": {
       "type": "integer"
      },
      "takes": {
       "type": "integer"
      },
      "estimate_usd": {
       "type": "number"
      }
     }
    },
    "replay": {
     "type": "boolean"
    },
    "made_at": {
     "type": "string"
    }
   }
  },
  "matte": {
   "description": "plates/<shot>/matte/matte.json: a bridge generation used only for its shape, as a matte that reveals real frames over the film's own base.",
   "type": "object",
   "required": [
    "schema",
    "shot",
    "take",
    "bridge",
    "base",
    "real",
    "params",
    "frames"
   ],
   "properties": {
    "generated": {
     "type": "string"
    },
    "schema": {
     "const": 1
    },
    "shot": {
     "$ref": "#/$defs/shot_id"
    },
    "take": {
     "type": "string",
     "pattern": "^t[0-9]+$"
    },
    "bridge": {
     "type": "object",
     "required": [
      "file",
      "sha256"
     ]
    },
    "base": {
     "type": "object",
     "required": [
      "file",
      "sha256"
     ]
    },
    "real": {
     "type": "object",
     "required": [
      "dir",
      "count"
     ]
    },
    "params": {
     "type": "object"
    },
    "frames": {
     "$ref": "#/$defs/sequence"
    },
    "mattes": {
     "type": [
      "object",
      "null"
     ]
    },
    "made_at": {
     "type": "string"
    }
   }
  },
  "track": {
   "description": "plates/<shot>/plate/track.json: where the plate's land meets its sky at each sample time, as points across the frame, so code can draw exactly on it.",
   "type": "object",
   "required": [
    "schema",
    "shot",
    "fps_num",
    "fps_den",
    "width",
    "height",
    "hue",
    "samples"
   ],
   "properties": {
    "generated": {
     "type": "string"
    },
    "schema": {
     "const": 1
    },
    "shot": {
     "$ref": "#/$defs/shot_id"
    },
    "frames": {
     "type": "object"
    },
    "fps_num": {
     "type": "integer",
     "minimum": 1
    },
    "fps_den": {
     "type": "integer",
     "minimum": 1
    },
    "width": {
     "type": "integer",
     "minimum": 1
    },
    "height": {
     "type": "integer",
     "minimum": 1
    },
    "hue": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "params": {
     "type": "object"
    },
    "samples": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "t",
       "frame",
       "pts",
       "span"
      ],
      "properties": {
       "t": {
        "type": "number",
        "minimum": 0
       },
       "frame": {
        "type": "integer",
        "minimum": 0
       },
       "pts": {
        "type": "array",
        "minItems": 2,
        "items": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 2,
         "maxItems": 2
        }
       },
       "span": {
        "type": "array",
        "items": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "minItems": 2,
        "maxItems": 2
       }
      }
     }
    },
    "made_at": {
     "type": "string"
    }
   }
  }
 }
}
