{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "slate/storyboard",
 "title": "script/storyboard.json",
 "description": "The gated storyboard `slate script build` writes from script/script.json (never by hand): acts of shots with a length each, in the films' shape (FILMROOT build/storyboard.json), plus the timing it was planned with and the frozen shot ids.",
 "type": "object",
 "required": ["acts"],
 "properties": {
  "generated": {"type": "string"},
  "title": {"type": ["string", "null"]},
  "version": {"type": ["string", "null"]},
  "film": {"type": ["string", "null"]},
  "language": {"type": "string"},
  "made_from": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
  "timing": {"type": "object", "properties": {"source": {"enum": ["planning", "takes"]}}},
  "runtime_s": {"type": "number", "minimum": 0},
  "target": {"type": "object"},
  "shot_ids": {
   "type": "object",
   "required": ["ids"],
   "properties": {
    "mode": {"enum": ["as-written", "renumber"]},
    "frozen_at": {"type": "string"},
    "ids": {"type": "array", "items": {"type": "object", "required": ["id", "source_id"],
                                       "properties": {"id": {"type": "string"}, "source_id": {"type": "string"}}}}
   }
  },
  "acts": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object",
    "required": ["name", "shots"],
    "properties": {
     "name": {"type": "string"},
     "job": {"type": "string"},
     "shots": {
      "type": "array", "minItems": 1,
      "items": {
       "type": "object",
       "required": ["id", "dur"],
       "properties": {
        "id": {"type": "string", "minLength": 1},
        "dur": {"type": "number", "minimum": 0},
        "vo": {"type": ["string", "null"]},
        "on_screen": {"type": ["string", "null"]},
        "picture": {"type": ["string", "null"]},
        "enter_token": {"type": ["string", "null"]},
        "lead": {"type": "number", "minimum": 0},
        "hold": {"type": "number", "minimum": 0},
        "generate": {"type": "object", "description": "the shot's generation request from script.json, carried through to timing/shots.json"},
        "transition": {"description": "how the shot hands to the next, as script.json gives it: words, or {kind, note} in the motion law's kinds",
                       "oneOf": [{"type": "string"}, {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string"}, "note": {"type": "string"}}}]},
        "engine": {"enum": ["remotion", "web", "ae"], "description": "the engine that draws the shot when it isn't its act's, from script.json, carried through to timing/shots.json"},
        "reading": {"type": "object", "description": "the shot's reading declaration from script.json (voice_matched, not_for_reading, labels, reason, count_events), for the script gates and `slate qa readtime`; count metadata grants no exemption",
                    "properties": {"count_events": {"type": "array", "minItems": 1,
                      "items": {"type": "object", "required": ["text", "events"], "additionalProperties": false,
                                "properties": {"text": {"type": "string", "minLength": 1, "pattern": "\\S"},
                                               "events": {"type": "array", "minItems": 1, "uniqueItems": true,
                                                          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}}}}}}
       }
      }
     }
    }
   }
  },
  "gates": {"type": "object"}
 }
}
