{
 "version": 1,
 "package": "fnf-after-effects-mcp",
 "note": "The fixed acceptance script Slate runs against a scratch project whenever the AE bridge's installed version changes, with After Effects open and a person's go (slate ae bridge acceptance --go). Read-only checks come first; the scratch project is only made once the open project has no unsaved changes, and it is saved inside Slate's data folder. Every mutating step names a read that proves whether it happened, because the bridge's batches aren't transactional: a retry first reads the project's state. ${...} values are filled in at run time (the scratch folder, and the speeds and influences Slate's own ease maths computes for the test ease).",
 "preflight": {"id": "project-state", "tool": "ae_project_info", "args": {}, "require_clean": true},
 "ops": [
  {"id": "catalog", "tool": "ae_catalog", "args": {}, "expect": {"min_operations": 150,
   "operations": ["project.new", "comp.create", "layer.create_shape", "shape.add_group", "shape.add_ellipse",
                  "shape.add_fill", "keyframe.add", "keyframe.set_easing", "layer.info", "font.list_missing",
                  "render.list_templates"]}},
  {"id": "looks", "tool": "ae_get_skill", "args": {}, "expect": {"looks": true}},
  {"id": "new-project", "tool": "ae_do", "args": {"operation": "project.new", "args": {"save": false}},
   "mutates": true, "verify": {"tool": "ae_project_info", "args": {}, "expect": {"num_items": 0}}},
  {"id": "comp", "tool": "ae_do",
   "args": {"operation": "comp.create", "args": {"name": "SLATE_ACCEPTANCE", "width": 640, "height": 360, "fps": 24,
                                                 "duration": 2, "bgColor": [0.08, 0.08, 0.08]}},
   "mutates": true, "verify": {"tool": "ae_do", "args": {"operation": "comp.info", "args": {"comp": "SLATE_ACCEPTANCE"}}}},
  {"id": "shape-layer", "tool": "ae_do",
   "args": {"operation": "layer.create_shape", "args": {"comp": "SLATE_ACCEPTANCE", "name": "Dot"}},
   "mutates": true,
   "verify": {"tool": "ae_do", "args": {"operation": "layer.info", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot",
                                                                            "includeProperties": false}}}},
  {"id": "group", "tool": "ae_do",
   "args": {"operation": "shape.add_group", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot", "name": "Dot"}},
   "mutates": true},
  {"id": "ellipse", "tool": "ae_do",
   "args": {"operation": "shape.add_ellipse", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot", "groupIndex": 1,
                                                       "size": [48, 48]}},
   "mutates": true},
  {"id": "fill", "tool": "ae_do",
   "args": {"operation": "shape.add_fill", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot", "groupIndex": 1,
                                                    "color": [1.0, 0.84, 0.2, 1.0]}},
   "mutates": true},
  {"id": "key-start", "tool": "ae_do",
   "args": {"operation": "keyframe.add", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot",
                                                  "property": ["Transform", "Position"], "time": 0,
                                                  "value": [80, 180]}},
   "mutates": true},
  {"id": "key-end", "tool": "ae_do",
   "args": {"operation": "keyframe.add", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot",
                                                  "property": ["Transform", "Position"], "time": 1,
                                                  "value": [560, 180]}},
   "mutates": true,
   "verify": {"tool": "ae_do", "args": {"operation": "layer.info", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot"}},
              "expect": {"keyframes_at_least": 2}}},
  {"id": "ease-out", "tool": "ae_do",
   "args": {"operation": "keyframe.set_easing", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot",
                                                         "property": ["Transform", "Position"], "keyIndex": 1,
                                                         "outSpeed": "${out_speed}", "outInfluence": "${out_influence}",
                                                         "inSpeed": 0, "inInfluence": 0.1}},
   "mutates": true},
  {"id": "ease-in", "tool": "ae_do",
   "args": {"operation": "keyframe.set_easing", "args": {"comp": "SLATE_ACCEPTANCE", "layer": "Dot",
                                                         "property": ["Transform", "Position"], "keyIndex": 2,
                                                         "inSpeed": "${in_speed}", "inInfluence": "${in_influence}",
                                                         "outSpeed": 0, "outInfluence": 0.1}},
   "mutates": true},
  {"id": "fonts", "tool": "ae_do", "args": {"operation": "font.list_missing", "args": {}}},
  {"id": "templates", "tool": "ae_do", "args": {"operation": "render.list_templates", "args": {}}},
  {"id": "save", "tool": "ae_save_project", "args": {"path": "${scratch}/acceptance.aep"}, "mutates": true,
   "verify": {"tool": "ae_project_info", "args": {}, "expect": {"file_endswith": "acceptance.aep"}}}
 ]
}
