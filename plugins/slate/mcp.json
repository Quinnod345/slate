{
 "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
 "mcpServers": {
  "slate": {
   "type": "stdio",
   "command": "slate",
   "args": [
    "mcp"
   ],
   "env": {
    "BROWSER": "none"
   }
  },
  "elevenlabs": {
   "type": "streamable-http",
   "url": "https://api.elevenlabs.io/v1/mcp"
  },
  "higgsfield": {
   "type": "streamable-http",
   "url": "https://mcp.higgsfield.ai/mcp"
  }
 }
}
