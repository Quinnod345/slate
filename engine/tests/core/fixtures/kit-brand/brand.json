{
 "name": "kit-e2e-brand",
 "note": "A neutral brand for the engines' end-to-end tests. Not a real brand: warm paper, graphite ink, a moss accent, the Mac's own installed fonts.",
 "palette": {
  "roles": {"page": "paper", "surface": "white", "ink": "graphite", "accent": "moss", "inverse": "night"},
  "paper": "#F1EFE9",
  "white": "#FFFFFF",
  "graphite": "#21211F",
  "moss": "#4E7A3A",
  "night": "#1D2230",
  "tones": {"ok": {"dot": "#2F7D52"}, "warn": {"dot": "#B7791F"}, "risk": {"dot": "#B83A2E"}}
 },
 "type": {
  "families": [
   {"role": "sans", "family": "Helvetica Neue", "weights": [400, 700], "source": "installed", "licence": "macOS system font, used in place, never redistributed"}
  ]
 },
 "motion": {
  "eases": {
   "enter": {"bezier": [0.2, 0.7, 0.2, 1], "lineage": "fixture: a firm deceleration"},
   "glide": {"kind": "sine", "lineage": "fixture: rest to rest"},
   "commit": {"bezier": [0.8, 0, 0.2, 1], "lineage": "fixture: a quick commit"},
   "leave": {"bezier": [0.5, 0, 1, 1], "lineage": "fixture: accelerate away"}
  },
  "durations": {"tick": 0.2, "quick": 0.32, "base": 0.52, "broad": 0.8, "camera": 1.2, "signature": 1.8},
  "staggers": {"char": {"frames": 2}, "word": {"frames": 3}, "line": {"frames": 4}, "block": {"frames": 6}},
  "stagger_cap": {"seconds": 0.6, "fraction": 0.5},
  "exit_factor": 0.75,
  "roles": {"entrance": "enter", "move": "glide", "state": "commit", "exit": "leave"},
  "overshoot": {"allowed": false}
 },
 "truth": {"banned_words": ["guaranteed", "risk-free"]},
 "look": {"id": "flat"}
}
